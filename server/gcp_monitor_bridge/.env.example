# Server Configuration
HOST=0.0.0.0
PORT=8080
BRIDGE_PORT=8099

# Multi-Project GCP Monitoring (Comma-separated project IDs)
GCP_PROJECT_ID=insurverse-develop
GCP_PROJECT_IDS=insurverse-develop,insurverse-uat,insurverse-app-63261,personal-453403,gen-lang-client-0923310914

# Service Account Credentials (Either mount ./credentials/gcp-sa.json OR paste raw JSON/base64 below)
# GCP_SA_JSON='{"type": "service_account", ...}'
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-sa.json
GCP_BILLING_ACCOUNT_ID=

# Basic Auth & API Security
BRIDGE_USERNAME=stackchan1
BRIDGE_PASSWORD=your_secure_password_here
BRIDGE_API_KEY=

# Optional Prometheus / OpenTelemetry Gateway
PROMETHEUS_URL=http://prometheus:9090

# Cache time in seconds
CACHE_TTL_SECONDS=15

